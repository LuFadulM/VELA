# =============================================================================
# Vela — environment variables
# =============================================================================
#
# Vela is built to run on the **Vercel Hobby + Supabase Free** stack. Every
# variable below is optional in development — the app falls back to mock
# data and skips auth when keys are absent.
#
# For deploy, set the variables in this section in your Vercel project.
# =============================================================================


# --- Anthropic (AI) ----------------------------------------------------------
# Without this, all AI features run in mock mode (canned summaries,
# pre-baked draft replies, etc.) and the app remains fully usable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6


# --- Supabase (auth, database, realtime) -------------------------------------
# Public keys (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=


# --- Postgres (Prisma) -------------------------------------------------------
# When using Supabase, copy these from
#   Project → Settings → Database → Connection string.
#
# DATABASE_URL must be the *pooled* connection (port 6543) — Vercel
# serverless functions create new connections per invocation, and the
# pooler is what keeps you under Supabase's 200-connection cap.
#
# DIRECT_URL is the *direct* connection (port 5432) — required for
# `prisma migrate` / `prisma db push` because pgBouncer can't speak
# Postgres' migration protocol.
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres


# --- Vercel cron -------------------------------------------------------------
# Auto-set when you create a cron in the Vercel dashboard. Used by
# /api/cron/weekly-briefing to authorize scheduled invocations.
CRON_SECRET=


# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =============================================================================
# Optional integrations (require paid accounts and are not needed on free tier)
# =============================================================================
# Nylas (Gmail / Outlook / Calendar unified API)
# NYLAS_CLIENT_ID=
# NYLAS_CLIENT_SECRET=
# NYLAS_API_KEY=

# Twilio (SMS / WhatsApp notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Slack / Zoom / direct Google OAuth (Supabase Auth handles Google by default)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
